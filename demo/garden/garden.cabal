cabal-version: 2.2
name:          garden
version:       0
build-type:    Simple

executable garden
  build-depends:
    , aeson
    , base
    , bytestring
    , colour
    , containers
    , gloss
    , lens
    , monad-logger
    , mtl
    , network-uri
    , optparse-applicative
    , ron
    , ron-rdt
    , ron-store-sqlite
    , stm
    , text
    , tree-view
    , unliftio
    , websockets

  default-extensions:
    ApplicativeDo
    BlockArguments
    EmptyCase
    FlexibleContexts
    ImportQualifiedPost
    LambdaCase
    NamedFieldPuns
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    RankNTypes
    ScopedTypeVariables
    StrictData
    TemplateHaskell
    ViewPatterns

  default-language:   GHC2021
  ghc-options:        -O2 -threaded -rtsopts -with-rtsopts=-N
  main-is:            Main.hs
  other-modules:
    Database
    Fork
    NetNode
    Options
    UI
