cabal-version: 3.0
name:          examples
version:       0
build-type:    Simple

common common
  -- global
  build-depends:      base

  -- project
  build-depends:      ron-rdt
  default-extensions:
    NoFieldSelectors
    StrictData

  default-language:   GHC2021

  -- workaround for HLint
  default-extensions: QuasiQuotes

executable TypicalUsage
  import:        common
  build-depends:
    , ron-schema
    , ron-storage

  main-is:       TypicalUsage.hs

executable CreateAndModify
  import:        common

  -- global
  build-depends:
    , mtl
    , pretty-simple
    , text

  -- project
  build-depends: ron
  main-is:       CreateAndModify.hs
